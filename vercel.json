{
  "version": 2,
  "rewrites": [
    {"source":"/api/shopee-search","destination":"/api/shopee-search.js"},
    {"source":"/api/analyze-screenshot","destination":"/api/analyze-screenshot.js"},
    {"source":"/api/supplier-image","destination":"/api/supplier-image.js"}
  ],
  "headers": [
    {"source":"/(.*)","headers":[
      {"key":"X-Content-Type-Options","value":"nosniff"},
      {"key":"Referrer-Policy","value":"strict-origin-when-cross-origin"}
    ]}
  ]
}
